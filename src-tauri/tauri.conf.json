{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ollivo",
  "version": "0.3.0",
  "identifier": "ru.ollivo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ollivo",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#0d0f09"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Ollivo"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://s3.twcstorage.ru/prisma-prava/ollivo/updates/latest.json",
        "https://github.com/WufCorp/Ollivo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0MTU3QjlFMTU2Qzk0RTUKUldUbGxHd1ZubnNWRk8yakxFSEFLZWtRQXp1Y3JkczFrMWxRZ0t5YlFxVUt0b01UdXUxRlFvM0EK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}